#!/usr/bin/env bash
set -e

usage() {
	cat <<EOF
Example: config $DOTFILES_MODULE_NAME
EOF
}
usage_err() {
	[ "$1" ] && echo "$1" >&2
	usage
	exit 1
}

while [ $# -gt 0 ]; do
	case $1 in
		--output-name)
			[ "$2" = "" ] && usage_err "Argument not specified"
			output_name="$2"
			shift
			;;
		*)
			usage_err "Invalid option: $1"
			;;
	esac
	shift
done

[ "$output_name" = "" ] && usage_err "Specify --output-name"

cmd sudo install -D -m 644 "$(writetext <<'EOF'
FILES+=(/usr/lib/firmware/edid/v226hql.bin)
EOF
)" /etc/mkinitcpio.conf.d/v226hql.conf

cmd sudo install -D -m 644 ./v226hql.bin /usr/lib/firmware/edid/v226hql.bin

newscript revert-resolution <<EOF
#!/usr/bin/env bash
kscreen-doctor output.$output_name.enable output.$output_name.mode.1920x1080@76
EOF

add_module_temp "plasma-LATE" "$(writetext <<EOF
PillRow {
    id: displayRow
    section: "Displays"
    text: "V226HQL"
    subtitle: "$output_name · 1920×1080"
    iconName: "video-display"
    options: [
        { label: "76 Hz", value: "1920x1080@76" },
        { label: "70 Hz", value: "1920x1080@70" },
        { label: "60 Hz", value: "1920x1080@60" }
    ]

    function queryDisplay() {
        exec("kscreen-doctor -j", (exitCode, stdout) => {
            displayRow.busy = false;
            if (exitCode !== 0 || !stdout) {
                return;
            }
            try {
                const jsonStart = stdout.indexOf("{");
                const data = JSON.parse(jsonStart >= 0 ? stdout.slice(jsonStart) : stdout);
                const outputs = data.outputs || [];
                const out = outputs.find(o => o.name === "$output_name");
                if (!out || out.connected === false) {
                    displayRow.shown = false;
                    return;
                }
                displayRow.shown = true;
                displayRow.dimmed = out.enabled === false;
                if (out.enabled === false) {
                    displayRow.activeValue = "";
                    return;
                }
                const modes = out.modes || [];
                const cur = modes.find(m => String(m.id) === String(out.currentModeId));
                if (cur) {
                    const rawRate = cur.refreshRate > 1000 ? cur.refreshRate / 1000 : cur.refreshRate;
                    const hz = Math.round(rawRate);
                    const computed = cur.size ? (cur.size.width + "x" + cur.size.height + "@" + hz) : "";
                    const match = displayRow.options.find(opt => opt.value === cur.name || opt.value === computed);
                    displayRow.activeValue = match ? match.value : computed;
                }
            } catch (e) {
            }
        });
    }

    onRefresh: queryDisplay()

    onSelected: value => {
        displayRow.busy = true;
        exec("bash -c 'kscreen-doctor output.$output_name.mode." + value + "'", () => {
            displayRow.queryDisplay();
        });
    }
}
EOF
)" 30

add_module_temp "boot-LATE" "$(writetext "drm.edid_firmware=$output_name:edid/v226hql.bin")"

