#!/usr/bin/env bash
set -e

usage() {
	cat <<EOF
Example: launch-windows
EOF
}
usage_err() {
	[ "$1" ] && echo "$1" >&2
	usage
	exit 1
}

[ "$(whoami)" = "root" ] || usage_err "Insufficient privileges, run as root"

while [ $# -gt 0 ]; do
	case $1 in
		*)
			usage_err "Invalid option: $1"
			;;
	esac
	shift
done

bootnum="$(efibootmgr | grep -oP '^Boot\K[0-9A-Fa-f]{4}(?=.*Windows)' | head -n1 || true)"
if [ -z "$bootnum" ]; then
	echo "Error: Windows EFI boot entry not found" >&2
	exit 1
fi

efibootmgr -n "$bootnum" && systemctl reboot
