#!/usr/bin/env bash
set -e

cmd sudo find ./scripts -type f -exec sh -c 'install -D -m 755 "$1" "/usr/local/bin/$(basename "$1")"' _ {} \;

add_module_temp "plasma-LATE" "$(writetext <<'EOF'
                    PlasmaComponents3.ItemDelegate {
                        Layout.fillWidth: true
                        text: "chlayout default"
                        icon.name: "system-run"
                        onClicked: {
                            executable.exec(`bash -c 'chlayout default'`)
                        }
                    }
                    PlasmaComponents3.ItemDelegate {
                        Layout.fillWidth: true
                        text: "chlayout gaming"
                        icon.name: "system-run"
                        onClicked: {
                            executable.exec(`bash -c 'chlayout gaming'`)
                        }
                    }
EOF
)"

