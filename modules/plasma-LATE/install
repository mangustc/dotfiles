#!/usr/bin/env bash
set -e

cp -rf ./org.kde.globalapplet "$DOTFILES_MODULE_TEMP"
cd "$DOTFILES_MODULE_TEMP"

target="./org.kde.globalapplet/contents/ui/main.qml"
items_dir="./org.kde.globalapplet/contents/ui/items"
mkdir -p "$items_dir"
tmpfile=$(mktemp) || exit 1

if [ -d "./files" ]; then
    idx=0
    while IFS= read -r file; do
        [ -f "$file" ] || continue
        idx=$((idx + 1))
        base="$(basename "$file" .qml)"
        clean_base="$(printf '%s' "$base" | tr -cs 'A-Za-z0-9_' '_')"
        clean_base="${clean_base%_}"
        qml_name="$(printf 'Item_%03d_%s.qml' "$idx" "$clean_base")"
        out_qml="$items_dir/$qml_name"

        if grep -q '^[[:space:]]*import[[:space:]]' "$file"; then
            cat "$file" > "$out_qml"
        else
            cat <<'EOF' > "$out_qml"
import QtQuick
import QtQuick.Layouts
import org.kde.plasma.core as PlasmaCore
import org.kde.plasma.components as PlasmaComponents3
import org.kde.plasma.extras as PlasmaExtras
import org.kde.kirigami as Kirigami
import ".."

EOF
            cat "$file" >> "$out_qml"
            printf '\n' >> "$out_qml"
        fi

        printf '        "items/%s",\n' "$qml_name" >> "$tmpfile"
    done < <(
        for f in "./files"/*; do
            [ -f "$f" ] || continue
            bn="$(basename "$f")"
            if [[ "$bn" =~ ^[0-9] ]]; then
                printf '0:%s\t%s\n' "$bn" "$f"
            else
                printf '1:%s\t%s\n' "$bn" "$f"
            fi
        done | LC_ALL=C sort -V -k1,1 | cut -f2-
    )
fi

sed "/\/\/ SED_MENU_ITEMS/ {
    r $tmpfile
    d
}" "$target" > "$target.tmp" && mv "$target.tmp" "$target"
rm -f "$tmpfile"

if ! [ -d ~/.local/share/plasma/plasmoids/org.kde.globalapplet ]; then
	cmd kpackagetool6 -t Plasma/Applet -i ./org.kde.globalapplet
else
	rm -rf ~/.local/share/plasma/plasmoids/org.kde.globalapplet/contents/ui/items
fi
cmd kpackagetool6 -t Plasma/Applet -u ./org.kde.globalapplet
