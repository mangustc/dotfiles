#!/usr/bin/env bash
set -e

cmd sudo install -D -m 644 ./ssh-agent.service /etc/systemd/user/ssh-agent.service
cmd systemctl --user daemon-reload
cmd systemctl --user enable ssh-agent.service

cmd sudo install -D -m 755 "$(writetext <<'EOF'
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.sock"
EOF
)" /etc/profile.d/dotfiles-ssh-agent.sh

cmd install -d -m 700 ~/.ssh

for file in "$DOTFILES_MODULE_SECRETS/.ssh"/*; do
	[ -f "$file" ] || continue
	base=$(basename "$file")
	if [[ "$base" == *.pub || "$base" == known_hosts ]]; then
		cmd install -m 644 "$file" ~/.ssh/"$base"
	else
		cmd install -m 600 "$file" ~/.ssh/"$base"
	fi
done
