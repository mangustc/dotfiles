#!/usr/bin/env bash
set -e

usage() {
	cat <<EOF
Example: config $DOTFILES_MODULE_NAME --flatpaks "
io.github.ryubing.Ryujinx
net.rpcs3.RPCS3
"
EOF
}
usage_err() {
	if ! [ "$1" = "" ]; then
		echo "$1" >&2
	fi
	usage
	exit 1
}

flatpaks=()
while [ $# -gt 0 ]; do
	case $1 in
		--flatpaks)
			[ $# -lt 2 ] && usage_err "Argument not specified"
			mapfile -t flatpaks < <(rm_empty "$2")
			shift
			;;
		*)
			usage_err "Invalid option: $1"
			;;
	esac
	shift
done

newscript flatpak-update << EOF
#!/usr/bin/env bash

flatpaks=(${flatpaks[*]@Q})

echo "Adding flathub repo if not exists"
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
mapfile -t installedFlatpaks < <(flatpak list --app --columns=application)

for installed in "\${installedFlatpaks[@]}"; do
	if (( \${#flatpaks[@]} == 0 )) || ! printf '%s\n' "\${flatpaks[@]}" | grep -Fxq -- "\$installed"; then
		echo "Removing \$installed"
		flatpak uninstall -y --noninteractive "\$installed"
	fi
done

for app in "\${flatpaks[@]}"; do
	echo "Installing \$app"
	flatpak install -y flathub "\$app"
done

echo "Removing unused apps and updating"
flatpak uninstall --unused -y
flatpak update -y
EOF
